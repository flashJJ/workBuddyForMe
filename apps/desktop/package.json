{
  "name": "@wbfm/desktop",
  "version": "2.5.0",
  "private": true,
  "description": "WorkBuddyForMe Electron 桌面壳",
  "author": "WorkBuddyForMe",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup && node scripts/dev.mjs",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "dist:win": "pnpm --filter @wbfm/web build && pnpm build && node scripts/prepare-server.mjs && electron-builder --win --x64 --publish never",
    "pack:dir": "pnpm --filter @wbfm/web build && pnpm build && node scripts/prepare-server.mjs && electron-builder --dir --x64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@wbfm/config": "workspace:*",
    "@wbfm/shared": "workspace:*",
    "electron": "44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6",
    "electron-updater": "^6.8.11"
  }
}
