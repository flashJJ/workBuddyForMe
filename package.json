{
  "name": "workbuddy-for-me",
  "version": "4.18.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "WorkBuddyForMe - 类 WorkBuddy 的私人 AI 平台（Next.js 全栈 + Electron）",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:web": "pnpm --filter @wbfm/web dev",
    "dev:desktop": "pnpm --filter @wbfm/desktop dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@wbfm/web",
    "dist:win": "pnpm --filter @wbfm/desktop dist:win",
    "archive:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/archive-installer.ps1",
    "release:win": "pnpm dist:win && pnpm archive:win",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify": "node scripts/release-manifest.mjs --check",
    "voice:manifest:check": "node scripts/voice/sync-kokoro-manifest.mjs --check",
    "voice:manifest:sync": "node scripts/voice/sync-kokoro-manifest.mjs --write",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "eslint . --ext .ts,.tsx",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @wbfm/web test:integration",
    "test:e2e": "pnpm --filter @wbfm/web test:e2e",
    "test:e2e:failed": "pnpm --filter @wbfm/web exec playwright test --last-failed",
    "test:e2e:visual": "pnpm --filter @wbfm/web test:e2e:visual",
    "test:e2e:desktop": "pnpm --filter @wbfm/desktop test:e2e",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:msw": "node scripts/check-msw.mjs",
    "test:contracts": "pnpm --filter @wbfm/core exec vitest run src/tools/contract",
    "test:eval": "node --test scripts/eval/lib/replay-report.test.mjs",
    "check:family": "node scripts/avatar/validate-family.mjs",
    "check:scenes": "pnpm --filter @wbfm/web exec vitest run src/features/avatar/script/scenes",
    "props:build": "node scripts/avatar/generate-props.mjs",
    "perf:pet-longrun": "node scripts/perf/pet-longrun.mjs",
    "check:perf": "node scripts/perf/perf-budget.mjs",
    "perf:baseline": "node scripts/perf/perf-budget.mjs --write-baseline",
    "check:ascii": "node scripts/check-ascii-width.mjs",
    "check:assets": "node scripts/assets/check-assets.mjs",
    "check:surfaces": "node scripts/check-surfaces.mjs --check",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:e2e-isolation": "node scripts/check-e2e-isolation.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "sync-version:check": "node scripts/sync-version.mjs --check",
    "eval:memory": "node scripts/eval/eval-memory.mjs",
    "memory:eval": "pnpm --filter @wbfm/core build && node scripts/eval/memory-report.mjs",
    "eval:companion": "pnpm --filter @wbfm/shared build && node scripts/eval/companion-report.mjs",
    "eval:agent": "node scripts/eval/eval-agent.mjs",
    "eval:agent:server": "node scripts/eval/with-server.mjs --script=scripts/eval/eval-agent.mjs",
    "eval:acceptance": "node scripts/acceptance/run.mjs",
    "eval:acceptance:report": "node scripts/acceptance/run.mjs --out=test-results/acceptance-v4.11.json",
    "eval:context": "node scripts/eval/eval-context.mjs",
    "eval:replay": "node scripts/eval/with-server.mjs --script=scripts/eval/eval-replay.mjs",
    "eval:rag": "promptfoo eval -c tests/eval/promptfoo/rag.yaml",
    "eval:tools": "node scripts/eval/tool-eval.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:lines && pnpm check:structure && pnpm check:cycles && pnpm check:msw && pnpm check:ascii && pnpm check:assets && pnpm check:surfaces && pnpm check:e2e-isolation",
    "verify:local": "pnpm check && pnpm test:eval && pnpm test:unit && pnpm test:integration && pnpm build:web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "msw": "^3.0.7",
    "prettier": "^3.4.0",
    "promptfoo": "^0.125.1",
    "tsup": "^8.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
